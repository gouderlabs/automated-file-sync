# Copy this file to .env and fill in your own values.
# .env is git-ignored and should NEVER be committed.

# --- Remote SFTP server ---
SFTP_HOST=test.rebex.net
SFTP_PORT=22
SFTP_USERNAME=demo
SFTP_PASSWORD=password
SFTP_REMOTE_DIR=/pub/example

# --- Local directories ---
DOWNLOAD_DIR=downloaded_files
PROCESSED_DIR=processed_files
LOG_DIR=logs

# --- Scheduling ---
RUN_TIME=19:00
RUN_ONCE_NOW=true

# --- Optional failure email alerts ---
NOTIFY_ON_FAILURE=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
