# Copy this file to .env and fill in your own values.
# .env is git-ignored and must NEVER be committed.

# --- Remote SFTP server ---
# Defaults below are the PUBLIC demo server test.rebex.net (credentials are public).
SFTP_HOST=test.rebex.net
SFTP_PORT=22
SFTP_USERNAME=demo
SFTP_PASSWORD=password
SFTP_REMOTE_DIR=/pub/example
SFTP_TIMEOUT=30

# --- Host key verification ---
# true  = refuse servers not listed in SFTP_KNOWN_HOSTS (run: python -m src.trust_host)
# false = accept any server (testing only, never with real data)
SFTP_STRICT_HOST_KEY=true
SFTP_KNOWN_HOSTS=known_hosts

# --- Local directories ---
DOWNLOAD_DIR=downloaded_files
PROCESSED_DIR=processed_files
LOG_DIR=logs
LOG_RETENTION_DAYS=30

# --- Scheduling ---
RUN_TIME=19:00
RUN_ONCE_NOW=true

# --- Optional failure email alerts ---
NOTIFY_ON_FAILURE=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
